<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Site-wide error detail toggle (taskpane and all endpoints):
             Set errorMode="Detailed" and scriptErrorSentToBrowser="true" to enable.
             Set errorMode="Custom" and scriptErrorSentToBrowser="false" to disable. -->
        <httpErrors errorMode="Custom" existingResponse="PassThrough" />
        <asp scriptErrorSentToBrowser="false" />
        <modules>
            <remove name="WebDAVModule" />
        </modules>
        <handlers>
            <remove name="WebDAVModule" />
            <remove name="StaticFile" />
            <add name="StaticFile" path="*" verb="GET" modules="StaticFileModule,DefaultDocumentModule,DirectoryListingModule" resourceType="Either" requireAccess="Read" />
        </handlers>
        <security>
            <requestFiltering removeServerHeader="true" />
        </security>
    </system.webServer>
</configuration>
